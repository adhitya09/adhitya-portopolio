# ==============================================================================
# Environment Variables for Adhitya Portfolio & CMS
# ==============================================================================

# Public Website URL
NEXT_PUBLIC_BASE_URL=https://adhityah.vercel.app

# Supabase Integration (Cloud Database & Asset Storage for Vercel)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email SMTP for Forgot Password (Optional - defaults to local developer mock)
SMTP_USER=adhityahermawan0906@gmail.com
SMTP_PASS=your-gmail-app-password
